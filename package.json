{
  "name": "hookslens",
  "version": "0.1.0",
  "description": "Developer panel for monitoring hooks in Next.js apps — SWR hooks, hook registry, fetch timeline, polling detector, and dedup visualiser.",
  "keywords": [
    "swr",
    "nextjs",
    "devtools",
    "debugging",
    "hooks",
    "react"
  ],
  "author": "Riordan Alfredo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riordanalfredo/hookslens.git"
  },
  "bugs": {
    "url": "https://github.com/riordanalfredo/hookslens/issues"
  },
  "homepage": "https://github.com/riordanalfredo/hookslens#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts --watch --format cjs,esm --dts",
    "build": "npm run clean && tsup src/index.ts --format cjs,esm --dts",
    "build:copy-template": "node ./src/scripts/build-copy-template.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build && npm run build:copy-template && npm test"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "swr": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
