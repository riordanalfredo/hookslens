{
  "name": "hookslens",
  "version": "0.3.13",
  "description": "Real-time fetch monitoring for Next.js apps with timeline visualization and duplicate detection. Optionally tracks SWR hook intent to catch parameter mismatches.",
  "keywords": [
    "nextjs",
    "fetch",
    "monitoring",
    "debugging",
    "devtools",
    "swr",
    "hooks",
    "timeline",
    "dashboard",
    "react",
    "observability"
  ],
  "author": "Riordan Alfredo <hello@rioalfredo.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riordanalfredo/hookslens.git"
  },
  "bugs": {
    "url": "https://github.com/riordanalfredo/hookslens/issues"
  },
  "homepage": "https://github.com/riordanalfredo/hookslens#readme",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "panel": [
        "dist/local-lib/src/app/hookslens/page.d.ts"
      ],
      "dist/local-lib/src/app/hookslens/page": [
        "dist/local-lib/src/app/hookslens/page.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/local-lib/src/app/hookslens/page.d.ts",
      "import": "./dist/local-lib/src/app/hookslens/page.jsx"
    },
    "./dist/local-lib/src/app/hookslens/page": {
      "types": "./dist/local-lib/src/app/hookslens/page.d.ts",
      "import": "./dist/local-lib/src/app/hookslens/page.jsx"
    },
    "./panel.css": "./dist/local-lib/src/app/hookslens/panel.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "next dev",
    "dev:lib": "tsup src/index.ts --watch --format cjs,esm --dts",
    "dev:panel": "vite --config src/panel-dev/vite.config.mjs",
    "demo": "vite --config demo/vite.config.mjs",
    "build": "npm run clean && tsup src/index.ts --format cjs,esm --dts",
    "build:demo": "vite build --config demo/vite.config.mjs",
    "build:local-lib": "node ./scripts/build-local-lib.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build && npm run build:local-lib && npm test"
  },
  "vitest": {
    "include": [
      "src/**/__tests__/**/*.{test,spec}.{ts,tsx}",
      "src/**/*.{test,spec}.{ts,tsx}"
    ],
    "exclude": [
      "**/node_modules/**",
      "**/dist/**"
    ]
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "swr": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.2",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^7.1.9",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
