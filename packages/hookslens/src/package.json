{
  "name": "hookslens",
  "version": "0.1.0",
  "description": "Developer panel for monitoring hooks in Next.js apps — SWR hooks, hook registry, fetch timeline, polling detector, and dedup visualiser.",
  "keywords": [
    "swr",
    "nextjs",
    "devtools",
    "debugging",
    "hooks",
    "react"
  ],
  "author": "Riordan Alfredo",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:copy-template": "node ./scripts/build-copy-template.mjs",
    "test": "vitest"
  },
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0",
    "swr": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
